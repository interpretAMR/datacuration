filter(subgroup == "Western Africa") %>%
select(locus, normalised_modelled_prevalence)
locus_estimates_df <- as.data.frame(locus_estimates) %>%
mutate(locus = rownames(ranef(fit_with_interaction)$locus))
# Function to normalise estimates to sum to 1
normalise_to_1 <- function(x) plogis(x) / sum(plogis(x))
# Add normalization step for probabilities
#locus_estimates_normalised <- locus_estimates_df %>%
#  mutate(
#    scaling_factor = sum(exp(Estimate.Intercept)),  # Compute the scaling factor for normalisation
#    normalised_estimate = exp(Estimate.Intercept) / scaling_factor,
#    normalised_lower = exp(Q2.5.Intercept) / scaling_factor,
#    normalised_upper = exp(Q97.5.Intercept) / scaling_factor
#  )
locus_estimates_normalised <- locus_estimates_df %>%
mutate(
normalised_estimate = normalise_to_1(Estimate.Intercept),
normalised_lower = normalise_to_1(Q2.5.Intercept),
normalised_upper = normalise_to_1(Q97.5.Intercept)
)
# Retain the locus column and reorder columns
locus_estimates_normalised <- locus_estimates_normalised %>%
select(locus, everything())
# Summarise and check probabilities
total_prob <- sum(locus_estimates_normalised$normalised_estimate)
cat("Total Probability (should be 1):", total_prob, "\n")
locus_estimates_normalised <- locus_estimates_normalised %>%
arrange(desc(normalised_estimate)) %>%
mutate(rank = row_number()) %>%
select(locus, everything())
locus_estimates_normalised <- locus_estimates_normalised %>%
select(locus, normalised_estimate, normalised_lower, normalised_upper, rank)
# Print the ranked locus probabilities
print(locus_estimates_normalised)
global_data <- locus_estimates_normalised
global_data
locus_effects <- ranef(fit_with_interaction)$locus
subgroup_effects <- ranef(fit_with_interaction)$subgroup
locus_subgroup_effects <- ranef(fit_with_interaction)$`locus:subgroup`
# Convert to data frames
locus_df <- as.data.frame(locus_effects) %>%
mutate(locus = rownames(locus_effects))
subgroup_df <- as.data.frame(subgroup_effects) %>%
mutate(subgroup = rownames(subgroup_effects))
locus_subgroup_df <- as.data.frame(locus_subgroup_effects) %>%
mutate(locus_subgroup = rownames(locus_subgroup_effects)) %>%
separate(locus_subgroup, into = c("locus", "subgroup"), sep = "_")
# Step 2: Check column names to match correctly
print(names(locus_df))
print(names(subgroup_df))
print(names(locus_subgroup_df))
# Step 3: Merge effects to compute combined log-odds
combined_effects <- locus_subgroup_df %>%
left_join(locus_df, by = "locus", suffix = c(".interaction", ".locus")) %>%
left_join(subgroup_df, by = "subgroup", suffix = c("", ".subgroup")) %>%
mutate(
combined_logodds = Estimate.Intercept + Estimate.Intercept.locus + Estimate.Intercept.interaction,
modelled_prevalence = plogis(combined_logodds)  # Transform to probability scale
)
# Step 4: Subset to the selected subgroup and calculate raw prevalence
selected_subgroup <- "Southern Africa"
raw_prevalence <- data_csv %>%
filter(subgroup == selected_subgroup) %>%
group_by(locus) %>%
summarise(
raw_prevalence = sum(event) / sum(n),
.groups = "drop"
)
# Step 5: Merge raw and modelled prevalence
comparison_data <- combined_effects %>%
filter(subgroup == selected_subgroup) %>%
select(locus, modelled_prevalence) %>%
inner_join(raw_prevalence, by = "locus")
# Step 6: Plot raw vs modelled prevalence
library(ggrepel)
comparison_plot <- ggplot(comparison_data, aes(x = raw_prevalence, y = modelled_prevalence, label = locus)) +
geom_point(size = 3, color = "blue") +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray") +
geom_text_repel(size = 3) +
theme_minimal() +
labs(
title = paste("Raw vs Modelled Prevalence in", selected_subgroup),
x = "Raw Prevalence",
y = "Modelled Prevalence",
caption = "Dashed line represents perfect agreement"
) +
theme(
plot.title = element_text(hjust = 0.5, size = 14),
axis.title = element_text(size = 12)
)
print(comparison_plot)
